class Solution {
public:
    bool isVovel(char ch){
        return ch=='a' || ch=='e' || ch=='i' || ch=='o' || ch=='u' ||  ch=='A' || ch=='E' || ch=='I' ||  ch=='O' || ch=='U';
    }
    string reverseVowels(string s){
        int left=0,right=s.length()-1;
        while(left<right){
            if(isVovel(s[left]) && isVovel(s[right])){
                swap(s[left],s[right]);
                left++;
                right--;
            }
            else if(isVovel(s[left]) && !isVovel(s[right])){
                right--;
            }
            else if(!isVovel(s[left]) && isVovel(s[right])){
                left++;
            }
            else{
                left++;
                right--;
            }
        }
        return s;
    }
};
