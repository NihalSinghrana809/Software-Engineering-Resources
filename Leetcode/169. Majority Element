class Solution{
public:
    int majorityElement(vector<int>&nums){
        int x=nums.size()/2;
        sort(nums.begin(),nums.end());
        for(int i=0;i<nums.size();i++){
            int a=nums[i];
            int b=nums[i+x];
            if(a==b){
                return a;
            }
        }
        return -1;
    }
};
