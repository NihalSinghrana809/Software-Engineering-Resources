class Solution{
public:
    bool check(vector<int>&nums){
        int idx=-1;
        vector<int>sortedArray;
        for(int i=0;i<nums.size()-1;i++){
            if(nums[i]>nums[i+1]){
                idx=i;
            }
        }
        if(idx==-1){
            return true;
        }
        for(int i=idx+1;i<nums.size();i++){
            sortedArray.push_back(nums[i]);
        }
        for(int i=0;i<=idx;i++){
            sortedArray.push_back(nums[i]);
        }
        sort(nums.begin(),nums.end());
        return sortedArray==nums;
    }
};
